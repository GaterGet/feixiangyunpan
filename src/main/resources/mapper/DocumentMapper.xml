<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fx.pan.mapper.DocumentMapper">

    <resultMap id="BaseResultMap" type="com.fx.pan.domain.Document">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="fileName" column="file_name" jdbcType="VARCHAR"/>
            <result property="context" column="context" jdbcType="VARCHAR"/>
            <result property="fileId" column="file_id" jdbcType="BIGINT"/>
            <result property="version" column="version" jdbcType="INTEGER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="identifier" column="identifier" jdbcType="VARCHAR"/>
            <result property="size" column="size" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,file_name,context,
        file_id,version,create_time,
        update_time,identifier,size
    </sql>

    <select id="selectByFileId" resultType="com.fx.pan.domain.Document">
        select *
        from document
        where file_id = #{id,jdbcType=BIGINT}
    </select>
</mapper>
